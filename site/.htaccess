DirectoryIndex index.html
Options -Indexes

RewriteEngine On
# HTTPS и без www (SSL принимает nginx, Apache видит X-Forwarded-Proto)
RewriteCond %{HTTP:X-Forwarded-Proto} =http [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://ipobatumi.ru%{REQUEST_URI} [R=301,L]

# Конфиг бота закрыт от просмотра
<Files "tg-config.php">
  Require all denied
</Files>

# Старые адреса WordPress -> на главную
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ / [R=301,L]

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
